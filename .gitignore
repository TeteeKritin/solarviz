# ─── Python ───────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
venv/
.venv/
env/

# ─── Environment & Secrets ────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ─── Alembic ──────────────────────────────────────
