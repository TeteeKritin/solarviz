docker-compose.override.yml

# ─── Database ─────────────────────────────────────
*.sql
*.dump
postgres_data/

# ─── Data Files ───────────────────────────────────
data/solar_dataset/*.csv
data/*.csv
*.xlsx

# ─── Logs ─────────────────────────────────────────
*.log
logs/
*.log.*

# ─── OS ───────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── IDE ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Reports / Exports ────────────────────────────
reports/
exports/
*.pdf
